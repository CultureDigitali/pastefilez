APP_NAME=PasteFilez
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.tld
APP_TIMEZONE=Europe/Rome
DEFAULT_LANGUAGE=en

DB_PATH=storage/app.sqlite
STORAGE_PATH=storage

SESSION_NAME=pz_sess
SESSION_LIFETIME_MIN=60
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict

MASTER_KEY_PATH=storage/.key

ENCRYPT_FILES_AT_REST=false
MAX_UPLOAD_MB=100
QUOTA_PER_USER_MB=10240
ALLOWED_MIME=image/*,video/*,audio/*,application/pdf,application/zip,application/json,text/*

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@your-domain.tld
SMTP_FROM_NAME=PasteFilez
SMTP_ENCRYPTION=tls

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=

DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT=

LOG_LEVEL=info
RATE_LIMIT_LOGIN_PER_HOUR=10

# Rate limit /api/v1/* (per hour, per API token or IP). 0 = use built-in default.
RATE_LIMIT_API_READ_PER_HOUR=0
RATE_LIMIT_API_WRITE_PER_HOUR=0
RATE_LIMIT_API_AI_PER_HOUR=0
RATE_LIMIT_API_AUTH_PER_HOUR=0
RATE_LIMIT_API_SEARCH_PER_HOUR=0
TRUSTED_PROXIES=
